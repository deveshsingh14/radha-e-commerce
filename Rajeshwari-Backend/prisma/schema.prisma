generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?  @unique
  password  String?
  googleId  String?  @unique
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())

  // ADDED: password reset fields
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // ADDED: saved delivery details so checkout can pre-fill
  phone   String? @unique
  address String?
  city    String?
  state   String?
  pincode String?

  cartItems         Cart[]
  wishlistItems     Wishlist[]
  orders            Order[]            @relation("CustomerOrders")
  deliveries        Order[]            @relation("DeliveryPartnerOrders")
  pushSubscriptions PushSubscription[]

  @@map("user")
}

model Product {
  id          Int               @id @default(autoincrement())
  title       String
  description String
  price       Float
  image       String?
  stock       Int
  keywords    String?
  createdAt   DateTime          @default(now())
  categories  ProductCategory[]
  // unique visitors per day, summed (the public 👁 count; shown from 10)
  viewCount   Int               @default(0)

  // pricing: price = selling price; mrp = printed max retail price (never
  // sell above it); costPrice = what the shop paid (ADMIN/OWNER only —
  // hidden from every query by the global omit in src/config/db.js)
  mrp        Float?
  costPrice  Float?
  // details shown on the product sheet
  brand      String?
  sku        String?  @unique
  size       String?
  color      String?
  material   String?
  tags       String[] @default([])
  // [{ label, value }] — category template fields + one-off extras
  attributes Json?

  cartItems     Cart[]
  wishlistItems Wishlist[]
  orderItems    OrderItem[]

  @@map("product")
}

model Category {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  // true -> shown on the Jewellery & Bangles page, hidden from the main feed
  isJewellery   Boolean           @default(false)
  // labels of the extra fields products in this category usually have,
  // e.g. ["Purity", "Weight"]; the admin form pre-fills them
  fieldTemplate Json?
  createdAt     DateTime          @default(now())
  products      ProductCategory[]

  @@map("category")
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int
  categoryId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([categoryId])
  @@map("product_category")
}

model Cart {
  id       Int @id @default(autoincrement())
  quantity Int

  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@map("cart")
}

model Wishlist {
  id Int @id @default(autoincrement())

  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@map("wishlist")
}

model Order {
  id Int @id @default(autoincrement())

  totalAmount Float

  status String @default("Pending")

  // ADDED: payment tracking
  // paymentMethod: "COD" | "UPI"
  // paymentStatus: "Pending" | "Paid" | "Refunded"
  paymentMethod String @default("COD")
  paymentStatus String @default("Pending")

  fullName String?
  phone    String?
  address  String?
  city     String?
  state    String?
  pincode  String?

  // Orders are business records: deleting the customer's account unlinks
  // them (userId -> NULL) instead of deleting them. customerEmail is a
  // snapshot so admins still know whose order it was.
  customerEmail String?

  userId Int?
  user   User? @relation("CustomerOrders", fields: [userId], references: [id], onDelete: SetNull)

  deliveryPartnerId Int?
  deliveryPartner   User? @relation("DeliveryPartnerOrders", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("order")
}

// Singleton row (id is always 1) toggling whether checkout is limited
// to the ServiceablePincode allow-list below.
model PincodeRestriction {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("pincode_restriction")
}

model ServiceablePincode {
  id        Int      @id @default(autoincrement())
  pincode   String   @unique
  // Where this pincode is. When set, checkout fills and locks city/state
  // from here so an address can't claim a different city for the pincode.
  area      String?
  city      String?
  state     String?
  createdAt DateTime @default(now())

  @@map("serviceable_pincode")
}

model OrderItem {
  id Int @id @default(autoincrement())

  quantity Int
  price    Float

  // Snapshot of the product at order time, so order history survives the
  // product being edited or deleted (productId becomes null on delete).
  title String?
  image String?

  orderId   Int
  productId Int?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

// One row per browser/device that opted in to order notifications.
// endpoint is the push service URL issued by the browser; p256dh/auth are
// the browser's public encryption keys (not secrets of ours).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

// ---------- Analytics (anonymous; no names, emails, phones or IPs) ----------
// Raw shop events, kept 90 days.
model AnalyticsEvent {
  id           Int      @id @default(autoincrement())
  type         String
  visitorId    String // random anonymous id from the browser
  productId    Int?
  categoryName String?
  term         String? // search text (cleaned)
  resultCount  Int?
  pincode      String?
  page         String?
  createdAt    DateTime @default(now())

  @@index([type, createdAt])
  @@index([productId, type, createdAt])
  @@index([createdAt])
  @@map("analytics_event")
}

// One row per (product, visitor, day) — counts unique views; kept 3 days.
model ProductView {
  id        Int      @id @default(autoincrement())
  productId Int
  visitorId String
  day       DateTime @db.Date

  @@unique([productId, visitorId, day])
  @@index([day])
  @@map("product_view")
}

// Permanent daily totals per product (small; powers Insights).
model ProductDailyStat {
  id        Int      @id @default(autoincrement())
  productId Int
  day       DateTime @db.Date
  views     Int      @default(0)
  saves     Int      @default(0)
  carts     Int      @default(0)

  @@unique([productId, day])
  @@index([day])
  @@map("product_daily_stat")
}
